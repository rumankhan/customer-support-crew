# Multi-Agent Customer Support Crew - Environment Configuration
# Copy to .env and set actual values (never commit .env)

# ========== LLM Provider Configuration ==========
# Provider: "openai" or "ollama"
LLM_PROVIDER=ollama

# ========== Ollama Cloud Configuration (when LLM_PROVIDER=ollama) ==========
# Ollama Cloud API key (create at https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Ollama Cloud base URL (default: https://ollama.com/v1)
OLLAMA_BASE_URL=https://ollama.com/v1

# Ollama model name (used for all agents)
OLLAMA_MODEL=gemma4:31b

# ========== OpenAI Configuration (when LLM_PROVIDER=openai) ==========
# OpenAI API key (required for OpenAI)
# OPENAI_API_KEY=your-openai-api-key-here

# Model Tier Configuration (SAD ADR-19)
# Low tier: used by classifier, retriever, escalation_manager
# OPENAI_MODEL_LOW=gpt-4o-mini

# Mid tier: used by response_specialist only
# OPENAI_MODEL_MID=gpt-4o-mini

# Fallback if tier not set
# OPENAI_MODEL=gpt-4o-mini

# ========== Runtime Configuration ==========
# Target runtime (locked to crewai for MVP)
AAMAD_TARGET_RUNTIME=crewai

# Backend API port (local demo often 8001 when 8000 is taken)
BACKEND_PORT=8001

# Frontend API base URL (for CORS and integration)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# ========== Agent Control Parameters ==========
# Maximum iterations per agent
MAX_ITER=12

# Maximum requests per minute (crew level)
MAX_RPM=10

# Crew wall-clock timeout for chat kickoff (seconds)
CHAT_TIMEOUT_SECONDS=180

# ========== Eval suite (optional) ==========
# See RUNNING.md § Evals — python -m evals.run
# EVAL_JUDGE_MODEL=gpt-4o
# EVAL_JUDGE_API_KEY=   # optional; falls back to OPENAI_API_KEY for --judge

# Classifier confidence threshold (escalate if below)
CLASSIFIER_CONFIDENCE_MIN=0.55

# ========== Knowledge Base Configuration ==========
# KB directory path (relative to backend/)
KB_DIR=backend/kb

# KB filename (CSV with id, title, body columns)
KB_FILE=articles.csv

# Similarity floor for retrieval (FTS rank mapped to 0–1)
KB_SIMILARITY_FLOOR=0.35

# SQLite database (KB + stub accounts/orders + HITL approvals)
KB_DB_PATH=backend/data/support.db
KB_TOP_K=3

# ========== HITL / Telegram manager bot ==========
# Create a bot with @BotFather, then:
#   python -m backend.scripts.telegram_get_chat_id
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
HITL_TIMEOUT_SECONDS=300

# ========== Logging Configuration ==========
# Log directory for prompt traces
LOG_DIR=project-context/2.build/logs

# CrewAI AMP tracing (dashboard at https://app.crewai.com after `crewai login`)
# Local Prompt Trace JSON is written regardless of this flag.
CREWAI_TRACING_ENABLED=true

# ========== Optional Features ==========
# Required for /api/approvals/* and /api/last-result (X-Operator-Key header).
# Use the same value in frontend/.env.local so the Next.js approvals proxy can inject it.
OPERATOR_API_KEY=dev-operator-key
